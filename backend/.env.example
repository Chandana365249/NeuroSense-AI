# Copy to backend/.env and fill in. Never commit the real .env.

NEUROSENSE_ENVIRONMENT=development
NEUROSENSE_LOG_LEVEL=INFO
NEUROSENSE_RANDOM_SEED=42

# Folder containing DEAP preprocessed-python participant files (s01.dat ...).
# Relative paths are resolved against the project root.
NEUROSENSE_DATASET_DIR=Dataset/DEAP
NEUROSENSE_OUTPUT_DIR=outputs

# PostgreSQL (SQLAlchemy URL, psycopg 3 driver). URL-encode special characters in the password.
NEUROSENSE_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/neurosense_ai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEUROSENSE_JWT_SECRET_KEY=
NEUROSENSE_ACCESS_TOKEN_EXPIRE_MINUTES=60

NEUROSENSE_API_PREFIX=/api
NEUROSENSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Labeling (DEAP self-assessment ratings are on a 1-9 scale; rating > threshold => "high")
NEUROSENSE_LABEL_STRATEGY=valence_binary
NEUROSENSE_VALENCE_THRESHOLD=5.0
NEUROSENSE_AROUSAL_THRESHOLD=5.0

# Historical (pre-protocol) baseline trainer only: whole participants held out by scripts.train_baseline
NEUROSENSE_TEST_PARTICIPANTS=3
NEUROSENSE_VALIDATION_PARTICIPANTS=2

# Evaluation Protocol v1.1 development participants used by protocol-aware candidate training
# (API "Train candidate" and scripts.train_candidate). Defaults to the 12 trusted participants; leave unset.
# The frozen final-test participants (s12 s17 s18 s20 s21 s23 s29 s30) are always refused.
# NEUROSENSE_DEVELOPMENT_PARTICIPANTS=["s01","s02","s03","s05","s07","s08","s09","s11","s15","s16","s22","s25"]

# Signal processing
NEUROSENSE_SAMPLING_RATE=128
NEUROSENSE_SEGMENT_SECONDS=4.0
